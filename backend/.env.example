# Copy to .env and adjust
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=corporate_gifting

# Email / OTP
# Leave SMTP_* blank to run in DEV mode: OTP is logged to the console and
# returned in the API response so you can test without configuring email.
NODE_ENV=development
OTP_TTL_MINUTES=10

# Admin console login (change these to update the admin credentials)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Gift@2026
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

