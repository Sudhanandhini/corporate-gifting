# Copy to .env and adjust
PORT=4000
# Origin of the deployed frontend (no path) — CORS is locked to this one origin.
# Local dev: http://localhost:5173
# Production: https://sunsysweb.co.in
CLIENT_ORIGIN=http://localhost:5173

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=corporate_gifting
# Max simultaneous pooled connections (also caps how many can sit idle).
DB_POOL_SIZE=10

# Redis response cache (optional). Leave unset to use the default below; if
# no Redis server is reachable at all, the app just runs without caching —
# nothing breaks. Run one locally with Docker: docker run -p 6379:6379 redis
REDIS_URL=redis://localhost:6379

# Email / OTP
# Leave SMTP_* blank to run in DEV mode: OTP is logged to the console and
# returned in the API response so you can test without configuring email.
# Set NODE_ENV=production on the deployed server.
NODE_ENV=development
OTP_TTL_MINUTES=10

# Admin console login (change these to update the admin credentials)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Gift@2026
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sunsys06@gmail.com
SMTP_PASS=efabfkprivprgxia
SMTP_FROM="Corporate Gifting <sunsys06@gmail.com>"

# Receives a copy of every new order notification
ADMIN_NOTIFY_EMAIL=support@sunsys.in
